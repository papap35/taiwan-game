# Google OAuth 用戶端 ID（Google Cloud Console → API 和服務 → 憑證 → OAuth 2.0 用戶端 ID，類型選「網頁應用程式」）
# 「已授權的 JavaScript 來源」請加入 http://localhost:5173 與 http://localhost:3000（以及正式網域）
GOOGLE_CLIENT_ID=

# 登入 session 簽章金鑰（未設定會自動產生並存在 data/.jwt-secret）
JWT_SECRET=

# 是否允許訪客登入（正式環境建議設為 false）
ALLOW_GUEST=true

PORT=3000
# DB_FILE=data/arcade.db
