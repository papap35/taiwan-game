  "dependencies": {
    "cannon-es": "^0.20.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.2",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
